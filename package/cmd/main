#!/bin/bash
set -eu

CONTAINER_NAME="music-mate-organizer"
case "${1:-}" in
  start|stop)
    # fnOS docker-project owns Compose lifecycle.
    exit 0
    ;;
  status)
    if docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null | grep -qx true; then
      exit 0
    else
      exit 3
    fi
    ;;
  *)
    exit 1
    ;;
esac
